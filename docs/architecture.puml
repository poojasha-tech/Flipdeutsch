' German Flashcards — Architecture Diagrams
' Render with: VS Code "PlantUML" extension (jebbs), or paste at https://www.plantuml.com/plantuml
' File contains 4 separate diagrams — each @startuml/@enduml block renders independently.








@startuml 01_Architecture
!theme plain
title German Flashcards — Component Architecture (Build-Time + Runtime)

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

actor "Learner\n(Browser)" as user

cloud "External Services" {
  component "YouTube\n(public captions)" as YT
  component "Google Gemini API\nmodel: gemini-2.5-flash-lite" as Gemini
}

node "Local Development Machine" {

  package "frontend/   (Task 13)" {
    component "index.html" as html
    component "styles.css\n(3D flip animation)" as css
    component "app.js\n(vanilla JS, fetch API)" as feJS
  }

  package "backend/" {
    component "app.js\n(Express server :3000)\nTask 12" as express

    package "backend/lib/   (offline scripts)" {
      component "fetchTranscript.js\n(Task 8 — isolated test)" as ft
      component "testGemini.js\n(Task 9 — isolated test)" as tg
      component "generateCards.js\n(Tasks 10–11 — full pipeline)" as gen
    }

    package "backend/prisma/" {
      component "schema.prisma\n(Video + Card models)" as schema
      component "db.js\n(PrismaClient singleton)" as dbjs
      component "seedVideos.js\n(Task 7 — seeds Video table)" as seed
      database "dev.db\n(SQLite)" as db
    }
  }
}

' === Runtime flow (user) ===
user --> html : 1. open page
html ..> css
html ..> feJS
user --> feJS : 2. pick level, flip cards
feJS --> express : 3. GET /api/cards?level=A1.1
express --> dbjs : 4. prisma.card.findMany
dbjs --> db : 5. SELECT
db --> dbjs
dbjs --> express
express --> feJS : 6. JSON (10 random cards)
feJS --> user : 7. render flip cards

' === Build-time / offline flow (developer) ===
seed --> dbjs : populate Video table
gen --> YT : fetch transcript
YT --> gen : caption chunks
gen --> Gemini : prompt + transcript\n+ JSON schema
Gemini --> gen : Card[] as JSON
gen --> dbjs : Card.createMany (with videoId FK)

dbjs ..> schema : reads model definitions
@enduml











@startuml 02_OfflinePipeline
!theme plain
title Offline AI Pipeline — generateCards.js (Tasks 10–11)

actor "Developer" as dev
participant "generateCards.js" as script
participant "youtube-transcript\n(npm pkg)" as ytPkg
participant "YouTube\n(captions)" as YT
participant "Google Gemini API" as Gemini
participant "Prisma Client" as prisma
database "SQLite\n(dev.db)" as db

dev -> script : node --env-file=.env\nlib/generateCards.js

== 1. Fetch transcript ==
script -> ytPkg : YoutubeTranscript.fetchTranscript(videoId)
ytPkg -> YT : HTTPS GET captions
YT --> ytPkg : caption XML
ytPkg --> script : [{ text, offset, duration }, ...]

script -> script : transcript.map(e => e.text).join(" ")\n→ one big string

== 2. Generate cards with AI ==
script -> Gemini : ai.models.generateContent({\n  model,\n  contents: prompt,\n  config: {\n    responseMimeType: "application/json",\n    responseSchema: <Card[]>\n  }\n})
Gemini -> Gemini : extract sentences,\nfit schema
Gemini --> script : { text: '[{"german":"...","english":"..."}, ...]' }

script -> script : JSON.parse(response.text)

== 3. Persist to DB ==
script -> prisma : prisma.video.findUnique({\n  where: { youtubeId }\n})
prisma -> db : SELECT FROM Video WHERE youtubeId=?
db --> prisma : Video row
prisma --> script : video { id, level, title }

script -> prisma : prisma.card.deleteMany({\n  where: { videoId: video.id }\n})
prisma -> db : DELETE (idempotency)
db --> prisma

script -> prisma : prisma.card.createMany({\n  data: cards.map(c => ({\n    level, german, english, videoId\n  }))\n})
prisma -> db : INSERT 10 Card rows
db --> prisma : { count: 10 }

script -> prisma : prisma.$disconnect()
script --> dev : "Saved 10 cards for <title>"
@enduml








@startuml 03_RuntimeUserFlow
!theme plain
title Runtime User Flow — Picking a Level and Flipping Cards (Tasks 12–13)

actor "Learner" as user
participant "Browser\n(HTML/CSS/JS)" as browser
participant "Express\n:3000" as express
participant "Prisma Client" as prisma
database "SQLite\n(dev.db)" as db

user -> browser : open http://localhost:3000

== Pick a level ==
user -> browser : select "A1.1"
browser -> express : GET /api/cards?level=A1.1
express -> prisma : prisma.card.findMany({\n  where: { level: "A1.1" },\n  take: 10 (random)\n})
prisma -> db : SELECT … ORDER BY RANDOM() LIMIT 10
db --> prisma : 10 Card rows
prisma --> express : Card[]
express --> browser : 200 OK\n[{ id, german, english, ... }, ...]

browser -> browser : store cards[],\nset index = 0,\nrender first card (front: german)

== Flip + Next loop ==
loop until user picks a new level
  user -> browser : click card
  browser -> browser : flip (CSS rotateY 180°)\nshow english on back
  user -> browser : click "Next"
  browser -> browser : index++\nrender cards[index]
end
@enduml











@startuml 04_DataModel
!theme plain
title Data Model — Prisma Schema (Video + Card)

entity "Video" as video {
  *id : Int  <<PK, autoincrement>>
  --
  *youtubeId : String  <<unique>>
  *title : String
  *level : String   ' "A1.1" .. "B2.2"
  *createdAt : DateTime  <<@default(now())>>
}

entity "Card" as card {
  *id : Int  <<PK, autoincrement>>
  --
  *level : String   ' redundant with video.level for fast querying
  *german : String   ' front of flashcard (sentence)
  *english : String  ' back of flashcard (translation)
  videoId : Int?  <<FK → Video.id, nullable>>
  *createdAt : DateTime  <<@default(now())>>
}

video ||--o{ card : "1 has many"

note right of card
  videoId is **nullable**.
  Why? So hand-written or
  legacy cards can live in
  the same table without a
  source video.
end note

note right of video
  Seeded once by
  seedVideos.js.
  Cards are AI-generated
  per video by
  generateCards.js.
end note
@enduml

' Flipdeutsch — Architecture Diagrams
' Render with: VS Code "PlantUML" extension (jebbs), or paste at https://www.plantuml.com/plantuml
' File contains 5 separate diagrams — each @startuml/@enduml block renders independently.




@startuml 01_Architecture
!theme plain
title Flipdeutsch — Component Architecture

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

actor "Learner\n(Browser)" as user

cloud "External Services" {
  component "YouTube\n(public captions)" as YT
  package "Google Gemini API" {
    component "gemini-2.5-flash-lite\n(offline batch quota)" as GeminiLite
    component "gemini-2.5-flash\n(live AI quota)" as GeminiFlash
  }
}

node "Local Development Machine" {

  package "frontend/" {
    component "index.html\n(level picker, card, modal,\nsubmit-URL, translate panel)" as html
    component "style.css\n(3D flip, progress bar,\nmodal, rating buttons)" as css
    component "script.js\n(session state, SR,\nTTS, fetch + render)" as feJS
    database "localStorage\n(scores, streak)" as ls
  }

  package "backend/" {
    component "app.js\n(Express :3000)" as express

    package "API routes" {
      component "GET /api/cards\nGET /api/stats" as readRoutes
      component "POST /api/generate\nPOST /api/explain\nPOST /api/grade" as liveRoutes
    }

    package "backend/lib/" {
      component "fetchTranscript.js\n(test)" as ft
      component "testGemini.js\n(test)" as tg
      component "generateCards.js\n(offline pipeline CLI)" as gen
    }

    package "backend/prisma/" {
      component "schema.prisma\n(Video + Card)" as schema
      component "db.js\n(PrismaClient singleton)" as dbjs
      component "seedVideos.js\n(seed 16 curated videos)" as seed
      database "dev.db\n(SQLite)" as db
    }
  }
}

' === Runtime flow (user) ===
user --> html : 1. open page
html ..> css
html ..> feJS
feJS <..> ls : read/write\nratings + streak

user --> feJS : pick level / click / rate / type
feJS --> readRoutes : GET /api/cards?level=X
readRoutes --> dbjs
dbjs --> db
db --> readRoutes : 10 random + video info
readRoutes --> feJS : JSON
feJS --> user : render flip cards

' === Live AI flow ===
feJS --> liveRoutes : POST /explain | /grade | /generate
liveRoutes --> GeminiFlash : prompt
GeminiFlash --> liveRoutes : JSON response
liveRoutes --> feJS

' === Build-time / offline flow (developer) ===
seed --> dbjs : populate Video table
gen --> YT : fetch transcript
YT --> gen : caption chunks
gen --> GeminiLite : prompt + transcript\n+ JSON schema
GeminiLite --> gen : Card[] as JSON
gen --> dbjs : Card.createMany (with videoId FK)

dbjs ..> schema : reads model definitions
@enduml




@startuml 02_OfflinePipeline
!theme plain
title Offline AI Pipeline — generateCards.js (batch generation)

actor "Developer" as dev
participant "generateCards.js" as script
participant "youtube-transcript\n(npm pkg)" as ytPkg
participant "YouTube\n(captions)" as YT
participant "gemini-2.5-flash-lite" as Gemini
participant "Prisma Client" as prisma
database "SQLite\n(dev.db)" as db

dev -> script : node --env-file=.env\nlib/generateCards.js [optional youtubeId]

== Setup ==
script -> prisma : prisma.video.findMany()\n(or filter by youtubeId)
prisma -> db : SELECT
db --> prisma
prisma --> script : Video[]

loop for each video (sequential, NOT parallel)

  == 1. Fetch transcript ==
  script -> ytPkg : YoutubeTranscript.fetchTranscript(youtubeId)
  ytPkg -> YT : HTTPS GET captions
  YT --> ytPkg : caption XML
  ytPkg --> script : [{ text, offset, duration }, ...]
  script -> script : transcript.map(e => e.text).join(" ")

  == 2. Generate cards with AI ==
  script -> Gemini : generateContent({\n  model: "gemini-2.5-flash-lite",\n  contents: prompt + transcript,\n  config: { responseMimeType, responseSchema }\n})
  Gemini -> Gemini : fit schema
  Gemini --> script : { text: '[{"german","english"}, ...]' }
  script -> script : JSON.parse(response.text)

  == 3. Persist to DB (idempotent) ==
  script -> prisma : prisma.card.deleteMany({ where: { videoId } })
  prisma -> db : DELETE
  script -> prisma : prisma.card.createMany({ data: cards.map(...) })
  prisma -> db : INSERT n Card rows
  db --> prisma : { count: n }
  script --> dev : "Saved n cards for [level] title"

end

note over script
  Errors caught PER VIDEO — one
  failure does not kill the batch.
  CLI arg lets you retry a single
  video without re-burning quota.
end note

script -> prisma : prisma.$disconnect()
@enduml




@startuml 03_RuntimeUserFlow
!theme plain
title Runtime User Flow — Studying a Level (with SR, TTS, source links)

actor "Learner" as user
participant "Browser\n(HTML/CSS/JS)" as browser
participant "localStorage" as ls
participant "Express :3000" as express
participant "Prisma Client" as prisma
database "SQLite" as db

user -> browser : open http://localhost:3000

== Boot ==
browser -> express : GET /api/stats
express -> prisma : groupBy level, count
prisma -> db : SELECT level, COUNT(*)\nGROUP BY level
db --> prisma
prisma --> express
express --> browser : [{level, total}, ...]
browser -> ls : read scores + streak
browser -> user : header shows streak + mastered count

== Pick a level ==
user -> browser : select "A1.1"
browser -> express : GET /api/cards?level=A1.1
express -> prisma : findMany({ where, include: { video } })
prisma -> db : SELECT Card JOIN Video
db --> prisma
prisma --> express
express --> browser : Card[] (with video info)

browser -> browser : queue = [...cards]\nposition = 0\nrender()

== Flip + Rate loop ==
loop until queue exhausted
  user -> browser : click 🔊
  browser -> browser : speechSynthesis.speak(de-DE)

  user -> browser : click card
  browser -> browser : .flipped class\n(CSS rotateY)
  browser -> user : show English back

  alt user knew it
    user -> browser : click "Knew it"
    browser -> ls : scores[id] = { rating: "knew", level, lastSeen }
  else user didn't know
    user -> browser : click "Didn't know"
    browser -> ls : scores[id] = { rating: "didnt", ... }
    browser -> browser : queue.splice(position+4, 0, card)\n(re-queue for later in session)
  end

  browser -> browser : position++\nrender next card
end

== Session done ==
browser -> ls : bump streak (once per day)
browser -> user : "You knew X of N cards"\nupdate header stats
@enduml




@startuml 04_LiveAIFlow
!theme plain
title Live AI Endpoints — explain, grade, generate

actor "Learner" as user
participant "Browser" as browser
participant "Express :3000" as api
participant "gemini-2.5-flash" as Gemini
participant "Prisma" as prisma
database "SQLite" as db
participant "YouTube" as YT

== 1. Click a German word → /api/explain ==
user -> browser : click word "Hund"
browser -> browser : modal opens, "Asking Gemini…"
browser -> api : POST /api/explain\n{ word: "Hund", sentence: "Der Hund ist groß." }
api -> Gemini : generateContent (plain text reply, no markdown)
Gemini --> api : { text: "..." }
api --> browser : { explanation }
browser -> user : modal shows grammar / meaning / usage

== 2. Type a translation → /api/grade ==
user -> browser : type "The dog is big.", click Check
browser -> api : POST /api/grade\n{ german, userTranslation }
api -> Gemini : generateContent\n(responseSchema enforces JSON shape)
Gemini --> api : { correct, feedback, betterTranslation }
api --> browser : same JSON
browser -> user : green/red feedback panel

== 3. Paste a YouTube URL → /api/generate ==
user -> browser : paste URL, pick level, Generate
browser -> api : POST /api/generate { youtubeUrl, level }
api -> api : extractYoutubeId(url)
api -> prisma : findUnique({ where: { youtubeId } })
alt video already exists
  prisma --> api : Video row
else first time
  api -> prisma : create Video (title = "User-submitted")
end
api -> YT : YoutubeTranscript.fetchTranscript
YT --> api : transcript
api -> Gemini : generateContent\n(uses -flash, NOT -flash-lite)
Gemini --> api : Card[] JSON
api -> prisma : deleteMany + createMany
prisma -> db : DELETE / INSERT
api --> browser : the saved cards (with video info)
browser -> browser : start session with new cards
browser -> user : flip cards immediately

note over api, Gemini
  All three live endpoints use
  **gemini-2.5-flash** — separate
  quota bucket from the offline
  batch script (which uses -flash-lite).
  parseGeminiError() turns 429 / 503
  responses into friendly UI messages.
end note
@enduml




@startuml 05_DataModel
!theme plain
title Data Model — Prisma Schema (Video + Card) + Frontend State

entity "Video" as video {
  *id : Int  <<PK, autoincrement>>
  --
  *youtubeId : String  <<unique>>
  *title : String
  *level : String   ' "A1.1" .. "B2.2"
  *createdAt : DateTime  <<@default(now())>>
}

entity "Card" as card {
  *id : Int  <<PK, autoincrement>>
  --
  *level : String   ' redundant with video.level for fast querying
  *german : String   ' front of flashcard (sentence)
  *english : String  ' back of flashcard (translation)
  videoId : Int?  <<FK → Video.id, nullable>>
  *createdAt : DateTime  <<@default(now())>>
}

video ||--o{ card : "1 has many"

note right of card
  videoId is **nullable**.
  Hand-written or legacy cards
  can live in the same table
  without a source video.
end note

note right of video
  Seeded ONCE by seedVideos.js.
  AI-generated cards attach
  per video via generateCards.js
  OR live via /api/generate.
end note

' Frontend-side state (not in DB)
package "Browser localStorage" {
  entity "flipdeutsch:scores" as scores {
    [cardId] : {
    --
      rating : "knew" | "didnt"
      level : String
      lastSeen : timestamp
    }
  }
  entity "flipdeutsch:stats" as stats {
    lastDate : "YYYY-MM-DD"
    --
    streak : Int
  }
}

card .. scores : "scored by id\n(no FK, just key lookup)"

note bottom of scores
  Per-card user ratings live here,
  NOT in the database. No accounts,
  no server-side user state.
  Per-browser, ~5MB cap.
end note
@enduml
